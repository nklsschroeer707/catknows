# Copy to .env next to compose.yml and fill in. Never commit the real .env —
# it holds the credentials to every catknows account.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate the values, don't invent them:
#   openssl rand -hex 32

DB_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=

# ADMIN_* only bootstrap the first admin on an empty database. Once the realm
# exists they are ignored, so it's safe (and tidy) to blank them afterwards.
