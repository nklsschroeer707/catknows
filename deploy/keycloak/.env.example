# Copy to .env next to compose.yml and fill in. Never commit the real .env —
# it holds the credentials to every catknows account.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate the values, don't invent them:
#   openssl rand -hex 32

DB_PASSWORD=

# ADMIN_* bootstrap the FIRST admin on an empty database and are ignored ever
# after. compose.yml deliberately does not reference them: an empty value is not
# an absent one, and Keycloak refuses to boot on an empty username. Uncomment the
# two KC_BOOTSTRAP_ADMIN_* lines in compose.yml for the first start, then remove
# them again — the reasoning is in the comment there.
ADMIN_USER=admin
ADMIN_PASSWORD=

# -- rotating the admin password ---------------------------------------------
# The password should not keep living in this file. Change it inside Keycloak,
# keep the new one in a password manager:
#
#   read -rs -p "New password: " NEWPW; echo
#   docker compose exec -T -e NEWPW="$NEWPW" keycloak sh -c '
#     /opt/keycloak/bin/kcadm.sh config credentials --server http://127.0.0.1:8080 \
#       --realm master --user admin --password "$OLD" >/dev/null &&
#     /opt/keycloak/bin/kcadm.sh set-password -r master --username admin \
#       --new-password "$NEWPW"'
#   unset NEWPW
#
# The setup-*.sh scripts read $KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD from the
# container's environment, so they stop working once the bootstrap variables are
# gone from compose.yml. Pass the credentials explicitly when you need one:
#
#   docker compose exec -T -e KC_BOOTSTRAP_ADMIN_USERNAME=admin \
#     -e KC_BOOTSTRAP_ADMIN_PASSWORD='<pw>' keycloak bash < setup-realm.sh
#
# That puts the password in your shell history — prefer `read -rs` into a
# variable and pass it as `-e KC_BOOTSTRAP_ADMIN_PASSWORD="$PW"`.
