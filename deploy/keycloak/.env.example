# Copy to .env next to compose.yml and fill in. Never commit the real .env —
# it holds the credentials to every catknows account.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate the values, don't invent them:
#   openssl rand -hex 32

DB_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=

# ADMIN_* only bootstrap the first admin on an empty database. Once the realm
# exists they are ignored, so blanking ADMIN_PASSWORD afterwards is not just
# tidy — it's the point. Change the admin password in Keycloak first, keep the
# new one in a password manager, then empty the line here:
#
#   docker compose exec -T -e NEWPW="$NEWPW" keycloak sh -c '
#     /opt/keycloak/bin/kcadm.sh config credentials --server http://127.0.0.1:8080 \
#       --realm master --user "$KC_BOOTSTRAP_ADMIN_USERNAME" \
#       --password "$KC_BOOTSTRAP_ADMIN_PASSWORD" >/dev/null &&
#     /opt/keycloak/bin/kcadm.sh set-password -r master --username admin \
#       --new-password "$NEWPW"'
#   sed -i '/^ADMIN_USER=/d; /^ADMIN_PASSWORD=/d' .env
#   docker compose up -d --force-recreate keycloak
#
# DELETE both lines, don't just blank the password: Keycloak refuses to boot on a
# username without a password and restart-loops with
# "bootstrap-admin-username available only when bootstrap admin password is set".
# (compose.yml now ties the username to the password to make that impossible,
# but deleting both is still the clean state.)
#
# The setup-*.sh scripts read $KC_BOOTSTRAP_ADMIN_PASSWORD from the container's
# environment, so they stop working once this is blank — pass the credentials
# explicitly when you need one again:
#   docker compose exec -T -e KC_BOOTSTRAP_ADMIN_USERNAME=admin \
#     -e KC_BOOTSTRAP_ADMIN_PASSWORD=<pw> keycloak bash < setup-realm.sh
