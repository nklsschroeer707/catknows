# Caddy config for the hosted catknows MCP server.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo mkdir -p /var/log/caddy && sudo chown -R caddy:caddy /var/log/caddy
#   sudo systemctl restart caddy
#
# The mkdir is not optional and bites once per new vhost: `caddy validate`
# passes, then loading fails with "permission denied" on the log file, which
# reads like a config error and isn't. Any site block added below needs that
# directory writable by the caddy user.
#
# Caddy gets the TLS cert from Let's Encrypt on first start — the domain's
# A/AAAA record must already point here, or the challenge fails.

mcp.catknows.app {
	# The interim bearer gate that lived here is gone: the MCP server now
	# verifies Keycloak tokens itself (CATKNOWS_OAUTH_ISSUER), so requests are
	# authenticated by someone who can be identified and revoked — and a shared
	# static token would have blocked the OAuth flow anyway, since clients must
	# reach the endpoint unauthenticated to discover where to log in.

	# The MCP server binds loopback only (CATKNOWS_HOST default). Everything
	# from outside arrives through here, over TLS, or not at all.
	reverse_proxy 127.0.0.1:8000 {
		# Streamable HTTP keeps responses open as SSE streams. Without this,
		# Caddy buffers them and tool calls appear to hang.
		flush_interval -1
	}

	encode zstd gzip

	# Skool sessions live behind this. Don't advertise the stack.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/log/caddy/mcp.catknows.app.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Request URIs can carry community slugs and member handles; the bodies
		# carry more. Log enough to debug a 502, not enough to rebuild someone's
		# member list from the access log.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# Keycloak — the OAuth authorization server (deploy/keycloak/compose.yml).
# No gate here on purpose: clients must reach the discovery and token
# endpoints *before* they have a token. That's what makes OAuth work.
auth.catknows.app {
	reverse_proxy 127.0.0.1:8080

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/log/caddy/auth.catknows.app.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Auth traffic carries credentials in headers and form bodies.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# The dashboard: landing page, legal pages, and the streamed Skool login (§2a).
# It serves deploy/web/ itself rather than Caddy doing it, because the same app
# owns /connect and the WebSocket — two servers on one domain would just mean
# splitting paths between them.
# One canonical host, not two: the OAuth redirect_uri is registered for exactly
# one origin, so serving both would break the login on whichever one wasn't
# registered. Redirect instead of duplicating.
www.catknows.app {
	redir https://catknows.app{uri} permanent
}

catknows.app {
	# Caddy proxies WebSockets transparently, but the screencast must not be
	# buffered or frames arrive in bursts.
	reverse_proxy 127.0.0.1:8001 {
		flush_interval -1
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The connect page inlines its own script and streams data: URIs as
		# frames; nothing is loaded from anywhere else, so say so.
		# font-src data: is what lets the landing's embedded woff2 load at all —
		# without it the browser silently drops Fraunces and Plex Mono, and the
		# page renders in system fonts (no CDN on purpose: GDPR).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' wss://catknows.app; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	log {
		output file /var/log/caddy/catknows.app.log {
			roll_size 10MiB
			roll_keep 5
		}
		# The session cookie is a live login here, same class of secret as the
		# MCP bearer token below.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
