# Caddy config for the hosted catknows MCP server.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo mkdir -p /var/log/caddy && sudo chown -R caddy:caddy /var/log/caddy
#   sudo systemctl restart caddy
#
# The mkdir is not optional and bites once per new vhost: `caddy validate`
# passes, then loading fails with "permission denied" on the log file, which
# reads like a config error and isn't. Any site block added below needs that
# directory writable by the caddy user.
#
# Caddy gets the TLS cert from Let's Encrypt on first start — the domain's
# A/AAAA record must already point here, or the challenge fails.

mcp.catknows.app {
	# INTERIM GATE — delete this block once Keycloak/OAuth is live.
	#
	# The MCP transport has no auth of its own yet, so without this the URL
	# *is* the credential: anyone who learns it reads the Skool session behind
	# it. A shared bearer token is not real authentication — it doesn't
	# identify anyone and can't be revoked per user — but it stops a leaked
	# URL from being enough.
	#
	# Set CADDY_GATE_TOKEN in Caddy's environment (systemd drop-in), matching
	# CATKNOWS_GATE in /etc/catknows/env.
	@unauthorized not header Authorization "Bearer {env.CADDY_GATE_TOKEN}"
	respond @unauthorized 401 {
		body "catknows: authentication required"
		close
	}

	# The MCP server binds loopback only (CATKNOWS_HOST default). Everything
	# from outside arrives through here, over TLS, or not at all.
	reverse_proxy 127.0.0.1:8000 {
		# Streamable HTTP keeps responses open as SSE streams. Without this,
		# Caddy buffers them and tool calls appear to hang.
		flush_interval -1
	}

	encode zstd gzip

	# Skool sessions live behind this. Don't advertise the stack.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/log/caddy/mcp.catknows.app.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Request URIs can carry community slugs and member handles; the bodies
		# carry more. Log enough to debug a 502, not enough to rebuild someone's
		# member list from the access log.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# Keycloak — the OAuth authorization server (deploy/keycloak/compose.yml).
# No gate here on purpose: clients must reach the discovery and token
# endpoints *before* they have a token. That's what makes OAuth work.
auth.catknows.app {
	reverse_proxy 127.0.0.1:8080

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/log/caddy/auth.catknows.app.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Auth traffic carries credentials in headers and form bodies.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# ponytail: the landing page is a separate concern — add a `catknows.app { ... }`
# block here when there's something to serve, or point the apex at Cloudflare
# Pages and leave this file to the MCP endpoint alone.
